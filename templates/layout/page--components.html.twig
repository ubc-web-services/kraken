{% extends "page.html.twig" %}

{% block primary_content %}
  <div{{ main_content_attributes.setAttribute('id', 'primary-content') }}>
    {% if page.heading %}
      {{ page.heading }}
    {% endif %}
    {% if page.help %}
      <div id="help-region">{{ page.help }}</div>
    {% endif %}
    <section class="section">
      {% if page.highlighted %}
        <div id="highlighted">{{ page.highlighted }}</div>
      {% endif %}
      {% block content %}
        {{ page.content }}
      {% endblock content %}

    <hr />
    <h3>Accordion</h3>
    {% embed 'kraken:accordion' with {
        customClasses: 'scooby-doo',
        headingLevel: 'h3',
        id: 'test-id',
        isOpen: false,
        title: 'this title is an h3',
        } %}
        {% block content %}
            <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Badge</h3>
    {% embed 'kraken:badge' with {
        background: 'bg-ubc-blue',
        color: 'text-white',
        customClasses: 'my-class',
        size: 'h-8 w-8',
        styleClasses: 'm-1 font-semibold tracking-tighter',
    } %}
        {% block content %}
            NEW
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Box</h3>
    {% embed 'kraken:box' with {
        align: 'align-full',
        background: 'bg-ubc-blue bg-dark',
        color: 'text-white',
        customClasses: 'p-6',
        dropshadow: false,
        margin: 'my-0',
        padding: 'p-6',
    } %}
        {% block content %}
            Some text here
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Button</h3>
    {% embed 'kraken:button' with {
        customClasses: 'text test-me',
        disabled: true,
        external: true,
        id: 'my-id',
        link: 'https://ubc.ca',
        size: 'text-sm',
        style: 'unit-button--light',
        target: true,
        text: 'this is the link title',
        variant: 'unit-button--small',
        } %}
    {% endembed %}

    {% embed 'kraken:button' with {
        buttonElement: true,
        external: true,
        id: 'my-id',
        link: 'https://ubc.ca',
        size: 'text-sm',
        style: 'unit-button--light',
        target: true,
        text: 'this is the link title',
        variant: 'unit-button--small',
        } %}
    {% endembed %}

    <a href="#" class="test link-external">Test link</a>

    <hr />
    <h3>Card: Icon</h3>
    {% embed 'kraken:card--icon' with {
        color: 'bg-ubc-blue bg-dark',
        customClasses: 'lostsa-custom-classes scooby yeah',
        figureStyles: 'my-figure-style',
        imageZoom: true,
        layout: 'flex-row',
        link: 'https://ubc.ca',
        noInsetContent: true,
        noInsetImage: true,
        noShadow: false,
        title: 'Blockchain icons are nice',
        titleStyles: 'my-title-style',
        target: true,
    } %}
        {% block media %}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-ubc-grey-3" viewBox="0 0 256 256">
                <rect width="256" height="256" fill="none"/>
                <line x1="184" y1="160" x2="216" y2="160" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
                <line x1="184" y1="96" x2="216" y2="96" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
                <rect x="40" y="40" width="176" height="176" rx="8" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
                <circle cx="112" cy="120" r="24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
                <path d="M80,168c3.55-13.8,17.09-24,32-24s28.46,10.19,32,24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
                <line x1="184" y1="40" x2="184" y2="216" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="16"/>
            </svg>
        {% endblock %}
        {% block content %}
            <p class="line-clamp-5">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Card: Image</h3>
    {% embed 'kraken:card--image' with {
        buttonClasses: 'unit-button',
        color: 'bg-ubc-blue bg-dark',
        customClasses: 'lostsa-custom-classes scooby yeah',
        imageZoom: true,
        layout: 'place-content-center text-center',
        link: 'https://ubc.ca',
        linkText: 'Read more',
        meta: 'January 14, 2026',
        noShadow: false,
        title: 'Blockchain icons are nice',
        target: true,
    } %}
        {% block media %}
        <img src="https://placehold.co/600x400" height="400" width="600" />
        {% endblock %}
        {% block content %}
        <p class="line-clamp-5">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Card: Primary</h3>
    {% embed 'kraken:card--primary' with {
        color: 'bg-ubc-blue bg-dark',
        customClasses: 'lostsa-custom-classes scooby yeah',
        figureStyles: 'mt-4',
        imageZoom: true,
        layout: 'ubc-card--vert',
        link: 'https://ubc.ca',
        meta: 'January 14, 2026',
        noInsetContent: false,
        noInsetImage: false,
        noShadow: false,
        subtitle: 'Subtitle text',
        target: true,
        title: 'Blockchain icons are nice',
        titlePrefix: 'Mr.',
        titleStyles: 'text-orange',
        titleSuffix: 'MFA',

    } %}
        {% block media %}
        <img src="https://placehold.co/600x400" height="400" width="600" />
        {% endblock %}
        {% block content %}
        <p class="line-clamp-5">Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Container</h3>
    {% embed 'kraken:container' with {
        backgroundColor: 'bg-white bg-light',
        customClasses: 'lostsa-custom-classes scooby yeah',
        customHeaderClasses: 'my-header-class',
        customInnerClasses: 'my-inner-class',
        customTitleClasses: 'my-title-class',
        id: 'my-id',
        title: 'Blockchain icons are nice',
        titleRight: false,
        verticalSpacing: 'my-6',
        width: 'no-container',

    } %}
        {% block content %}
        <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Featurette</h3>
    {% embed 'kraken:featurette' with {
        customClasses: 'lostsa-custom-classes scooby yeah',
        imageZoom: true,
        layout: 'mt-auto text-center',
        link: 'https://ubc.ca',
        meta: 'Jan.16, 2026',
        noShadow: true,
        target: true,
        title: 'Blockchain icons are nice',
    } %}
        {% block media %}
        <img src="https://placehold.co/600x400" height="400" width="600" />
        {% endblock %}
        {% block content %}
        <p>Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>
        {% endblock %}
        {% block actions %}
        {% embed 'kraken:button' with {
            customClasses: 'text test-me',
            disabled: true,
            external: true,
            id: 'my-id',
            link: 'https://ubc.ca',
            size: 'text-sm',
            style: 'unit-button--light',
            target: true,
            text: 'this is the link title',
            variant: 'unit-button--small',
        } %}
        {% endembed %}
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Masthead</h3>
    {% embed 'kraken:masthead' with {
        backgroundLight: false,
        customClasses: 'lostsa-custom-classes scooby yeah',
        gradient: true,
        isPageTitle: true,
        text: 'A small amount of text',
    } %}
        {% block media %}
        <img src="https://placehold.co/1200x400" height="400" width="1200" />
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Masthead: Slide</h3>
    {% embed 'kraken:masthead--slide' with {
        backgroundLight: false,
        customClasses: 'lostsa-custom-classes scooby yeah',
        customContainerClasses: 'velma-daphne-fred shaggy',
        gradient: true,
        hasImage: true,
        isPageTitle: true,
        link: 'https://ubc.ca',
        linkStyle: 'unit-button--light',
        linkText: 'Read more',
        showLink: true,
        showText: true,
        target: true,
        text: 'A small amount of text',
        texture: 'texture-class',
        title: 'I am a title',
    } %}
        {% block media %}
        <img src="https://placehold.co/1200x400" height="400" width="1200" />
        {% endblock %}
    {% endembed %}

    <hr />
    <h3>Tag</h3>
    {% embed 'kraken:tag' with {
        link: 'https://ubc.ca',
        customClasses: 'p-6',
    } %}
        {% block content %}
            Some text here
        {% endblock %}
    {% endembed %}

    </section>
  </div>
{% endblock primary_content %}

